{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    ".node-version",
    "**/.env.*",
    "**/tsconfig*.json",
    "internal/node-utils/src/**/*.ts",
    "internal/vite-config/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^stub"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "persistent": true
    },
    "stub": {
      "dependsOn": ["^stub"],
      "outputs": ["dist/**"]
    },
    "@fast-vue3/backend-mock#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    }
  }
}
