{
  "name": "fast-vue3",
  "version": "1.0.0",
  "description": "A Vue3 Monorepo engineering platform integrating multiple admin UI ecosystems",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:backend-mock": "pnpm -F @fast-vue3/backend-mock run build",
    "build:site-antd": "pnpm -F @fast-vue3/site-antd run build",
    "build:site-arco": "pnpm -F @fast-vue3/site-arco run build",
    "build:site-ele": "pnpm -F @fast-vue3/site-ele run build",
    "build:site-idux": "pnpm -F @fast-vue3/site-idux run build",
    "build:site-naive": "pnpm -F @fast-vue3/site-naive run build",
    "build:site-primevue": "pnpm -F @fast-vue3/site-primevue run build",
    "build:site-tdesign": "pnpm -F @fast-vue3/site-tdesign run build",
    "build:web-app": "pnpm -F @fast-vue3/web-app run build",
    "build:web-antd": "pnpm -F @fast-vue3/web-antd run build",
    "build:web-arco": "pnpm -F @fast-vue3/web-arco run build",
    "build:web-ele": "pnpm -F @fast-vue3/web-ele run build",
    "build:web-idux": "pnpm -F @fast-vue3/web-idux run build",
    "build:web-naive": "pnpm -F @fast-vue3/web-naive run build",
    "build:web-primevue": "pnpm -F @fast-vue3/web-primevue run build",
    "build:web-tdesign": "pnpm -F @fast-vue3/web-tdesign run build",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "create-app": "vsh create-app",
    "dev": "pnpm dev:mock",
    "dev:backend-mock": "pnpm dev:mock:api",
    "dev:mock": "cross-env VITE_DEV_BACKEND=mock turbo-run dev",
    "dev:mock:api": "pnpm -F @fast-vue3/backend-mock run dev",
    "dev:site-antd": "pnpm -F @fast-vue3/site-antd run dev",
    "dev:site-arco": "pnpm -F @fast-vue3/site-arco run dev",
    "dev:site-ele": "pnpm -F @fast-vue3/site-ele run dev",
    "dev:site-idux": "pnpm -F @fast-vue3/site-idux run dev",
    "dev:site-naive": "pnpm -F @fast-vue3/site-naive run dev",
    "dev:site-primevue": "pnpm -F @fast-vue3/site-primevue run dev",
    "dev:site-tdesign": "pnpm -F @fast-vue3/site-tdesign run dev",
    "dev:server": "cross-env VITE_DEV_BACKEND=server turbo-run dev",
    "dev:server:api": "docker compose -f ../../../../backend/java/fast-vue3-server/compose.yml --project-directory ../../../../backend/java/fast-vue3-server --profile app up -d --build",
    "dev:web-app": "pnpm -F @fast-vue3/web-app run dev",
    "dev:web-antd": "pnpm -F @fast-vue3/web-antd run dev",
    "dev:web-arco": "pnpm -F @fast-vue3/web-arco run dev",
    "dev:web-ele": "pnpm -F @fast-vue3/web-ele run dev",
    "dev:web-idux": "pnpm -F @fast-vue3/web-idux run dev",
    "dev:web-naive": "pnpm -F @fast-vue3/web-naive run dev",
    "dev:web-primevue": "pnpm -F @fast-vue3/web-primevue run dev",
    "dev:web-tdesign": "pnpm -F @fast-vue3/web-tdesign run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test": "pnpm -r --if-present run test",
    "typecheck": "node scripts/generate-auto-import-types.mjs && tsc --noEmit -p tsconfig.json && pnpm -r --if-present run type-check && turbo typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@fast-vue3/commitlint-config": "workspace:*",
    "@fast-vue3/eslint-config": "workspace:*",
    "@fast-vue3/oxfmt-config": "workspace:*",
    "@fast-vue3/oxlint-config": "workspace:*",
    "@fast-vue3/prettier-config": "workspace:*",
    "@fast-vue3/stylelint-config": "workspace:*",
    "@fast-vue3/tsconfig": "workspace:*",
    "@fast-vue3/turbo-run": "workspace:*",
    "@fast-vue3/vite-config": "workspace:*",
    "@fast-vue3/vsh": "workspace:*",
    "@stylistic/stylelint-plugin": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "cz-git": "catalog:",
    "czg": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss-html": "catalog:",
    "postcss-scss": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-recommended": "catalog:",
    "stylelint-config-recommended-scss": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-scss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=9.5.0"
  },
  "packageManager": "pnpm@9.15.9"
}
