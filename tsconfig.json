{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./internal/tsconfig/web.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    "*.config.ts",
    "apps/*/vite.config.ts",
    "internal/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.nitro/**",
    "**/.output/**"
  ]
}
